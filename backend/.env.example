# Supabase / Neon connection string
DATABASE_URL=postgresql://USER:PASSWORD@host:5432/postgres?sslmode=require

# Random long string for JWT
SECRET_KEY=change-me-to-a-long-random-secret

# Your Vercel frontend URL(s), comma-separated
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Admin login (set on Render for production)
ADMIN_USERNAME=maitri_admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_EMAIL=admin@maitricafe.com
ADMIN_FULL_NAME=Maitri Manager
